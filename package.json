{
  "name": "roblox-piano-player",
  "version": "1.3.2",
  "description": "Tempo-controlled Roblox piano sheet, MIDI, and audio player",
  "author": "Roblox Piano Player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "build:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@audio/decode": "^3.15.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "koffi": "^2.14.1",
    "wav-decoder": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.robloxpianoplayer.desktop",
    "productName": "Roblox Piano Player",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "midi-utils.js",
      "index.html",
      "styles.css",
      "sheet.txt",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@spotify/basic-pitch/model/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "Roblox Piano Player"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
